# ==========================================
# Credenciais e permissões
# ==========================================
DISCORD_TOKEN=seu_token_do_bot_aqui
ADMIN_USER_ID=seu_id_do_discord_aqui

# ==========================================
# Prefixos de comandos
# ==========================================
BOT_PREFIX=!smashorpass
TRABALHO_COMMAND=!trabalho
ANIVERSARIO_COMMAND=!aniversario
IPV4_COMMAND=!ipwatch
EPICFREE_COMMAND=!epicfree
DISKSPACE_COMMAND=!diskspace
VOICE_ABSENCE_COMMAND=!sumido

# Minimo de dias sumido de call para disparar o anuncio de retorno (padrão: 3)
VOICE_ABSENCE_MIN_DAYS=3

# ==========================================
# Agendamentos e tempo de rede (ms)
# ==========================================
IPV4_CHECK_INTERVAL_MS=600000
IPV4_FETCH_TIMEOUT_MS=8000
EPICFREE_CHECK_INTERVAL_MS=21600000
EPICFREE_FETCH_TIMEOUT_MS=15000
EPICFREE_LOCALE=pt-BR
EPICFREE_COUNTRY=BR
EPICFREE_ALLOW_COUNTRIES=BR

# Horario do anuncio de aniversario (hora local da maquina)
BIRTHDAY_ANNOUNCE_HOUR=9
BIRTHDAY_ANNOUNCE_MINUTE=0

# Horario da atualizacao de espaço em disco (hora local da maquina)
DISKSPACE_ANNOUNCE_HOUR=10
DISKSPACE_ANNOUNCE_MINUTE=0

# Margem de reserva de segurança em GB
DISKSPACE_RESERVE_GB=100

# ==========================================
# Regras e persistência
# ==========================================
WORK_PATTERN_ANCHOR=2026-01-01
DB_PATH=./data/bot.db
